# ============================================
#  SPA Routing + Performance for Apache hosting
# ============================================

# Enable URL rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (uncomment if SSL is installed)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www (optional - uncomment to enable)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Do NOT rewrite real files, directories, or symlinks
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Send everything else to index.html (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# ============================================
#  GZIP Compression
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/x-javascript application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ============================================
#  Browser Caching
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache so users get updates fast
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS — hashed by Vite, cache long
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Audio (for Quran recitations)
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType audio/mp3 "access plus 1 month"
  ExpiresByType audio/ogg "access plus 1 month"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ============================================
#  Cache-Control headers
# ============================================
<IfModule mod_headers.c>
  # Hashed assets — immutable, cache forever
  <FilesMatch "\.(js|css|woff|woff2|ttf|otf|eot|jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
#  MIME types
# ============================================
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType application/manifest+json .webmanifest
</IfModule>

# ============================================
#  Disable directory listing
# ============================================
Options -Indexes

# ============================================
#  Protect sensitive files
# ============================================
<FilesMatch "(^\.|package\.json|package-lock\.json|bun\.lock|tsconfig\.json|vite\.config\.ts|\.env)">
  Require all denied
</FilesMatch>

# Default document
DirectoryIndex index.html
